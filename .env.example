# Supabase Project Settings > API. Public key only, never service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this key with NUXT_PUBLIC or include in browser code.
SUPABASE_SECRET_KEY=
# Optional standalone demo. Keep false in the hosted app: accounts use the shared DB.
GYMBRAIN_LOCAL_DEMO=false
PORT=3001
# Withings: backend only. Encryption key is 32 random bytes encoded as 64 hex characters.
APP_ORIGIN=https://gymbrain-llkm.onrender.com
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_ENCRYPTION_KEY=
# WHOOP: backend only; enable after applying migration 005 and registering the app.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_ENCRYPTION_KEY=
